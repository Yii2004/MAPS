fn scale(int32 x) -> int32 {
    return x * 1;
}

tensor<int32> A = [[1, 2], [3, 4]];
tensor<int32> B = [[5, 6], [7, 8]];
tensor<int32, 2, 2> C;

int32 loops = 0;
for (int32 i = 0; i < 2; i = i + 1) {
    loops = loops + scale(1);
}

gemm(A, B, C);

if (C[0][0] == 19) {
    print("tensorc npu ok\n");
} else {
    print("tensorc npu bad\n");
}

while (loops < 2) {
    loops = loops + 1;
}

return 0;
